{
  "name": "phronis-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:quant && nest build && tsc-alias -p tsconfig.build.json && node scripts/postbuild-alias.js",
    "build:quant": "tsc -p ../trading/tsconfig.build.json",
    "start": "npm run build:quant && nest start",
    "start:dev": "npm run build:quant && nest start --watch",
    "start:prod": "node dist/main",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:test": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.106.0",
    "axios": "^1.13.6",
    "bullmq": "^5.65.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3"
  }
}
