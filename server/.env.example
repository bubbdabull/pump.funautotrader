PORT=3001

# Optional background jobs — omit or set REDIS_DISABLED=true if Redis is not running
REDIS_DISABLED=true
# REDIS_URL=redis://localhost:6379

SUPABASE_URL=https://ypzgxjdnllwoohybayus.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct (IPv6 only on many networks — often fails locally with P1000 / timeout)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.ypzgxjdnllwoohybayus.supabase.co:5432/postgres

# Preferred for local dev + Prisma: Supabase Dashboard → Database → Connection Pooling → Session mode → URI
DATABASE_URL="postgresql://postgres.ypzgxjdnllwoohybayus:[PASSWORD]@aws-1-REGION.pooler.supabase.com:5432/postgres"

# Recommended: use Supabase REST with service role (no DATABASE_URL password hassles)
USE_SUPABASE_REST_DB=true
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres via Prisma (set USE_SUPABASE_REST_DB=false and fix DATABASE_URL)
DATABASE_OPTIONAL=true

PUMP_FUN_API_URL=https://frontend-api.pump.fun
# REST backfill: holders, volume, mcap (runs on Fly even without Redis)
PUMP_FUN_BOOTSTRAP_LIMIT=100
PUMP_FUN_SYNC_INTERVAL_MS=120000

PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Required for per-mint trade ticks (EV engine + auto-trader). Wallet needs ~0.02 SOL linked on PumpPortal.
PUMPPORTAL_API_KEY=
# Max mints with live buy/sell stream (~0.01 SOL per 10k trade messages)
PUMPPORTAL_MAX_TRADE_SUBS=250
PUMPPORTAL_TRADE_SUB_BATCH=80
PUMPPORTAL_TRADE_SUB_ROTATE_MS=45000

# In-memory live feed size (also persisted to Supabase when enabled)
LIVE_FEED_MAX=300

# Required for real holder counts (getProgramAccounts + largest holders)
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
# Fallback RPC if HELIUS_API_KEY unset (public RPC rate-limits heavily)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Optional: Bubblemaps cluster / holder map (https://docs.bubblemaps.io)
BUBBLEMAPS_API_KEY=
HOLDER_ENRICH_INTERVAL_MS=90000
HOLDER_ENRICH_BATCH=35
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Optional second WS (PumpStream-compatible URL)
# PUMPSTREAM_WS_URL=wss://...

# Execution engine
EXEC_MAX_RETRIES=3
EXEC_MIN_PRIORITY_FEE=0.00005
EXEC_MAX_PRIORITY_FEE=0.001
JITO_BUNDLES_ENABLED=false
