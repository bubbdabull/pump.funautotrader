# Copy to server/.env and fill in values
# cp server/.env.example server/.env

# Local dev only — do NOT add PORT to fly secrets (proxy expects 8080)
PORT=3001

# Upstash Redis — snapshots every 20s + optional persist worker fan-out
# Upstash: copy "Redis URL" from console (rediss://…), NOT the REST URL.
# Fly: fly secrets set REDIS_URL='rediss://...' REDIS_DISABLED=false -a YOUR_APP
REDIS_DISABLED=true
# REDIS_URL=rediss://default:TOKEN@YOUR-ENDPOINT.upstash.io:6379

# Fly process role: api | persist | all (default all locally)
# PHRONIS_PROCESS_ROLE=all

# ─── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

USE_SUPABASE_REST_DB=true
# One-time full wipe of Token + quant rows on boot — unset after first deploy
# SUPABASE_PURGE_FEED_ON_START=true
DATABASE_OPTIONAL=true
# DATABASE_URL="postgresql://postgres.PROJECT:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Pump.fun REST ────────────────────────────────────────────────
PUMP_FUN_API_URL=https://frontend-api-v3.pump.fun
# Scan limits live in trading/constants.ts (PUMP_FUN_SCAN_TARGET, DISCOVERY_POOL_MAX, …)

# ─── PumpPortal (required for live feed + trade stream) ───────────
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=

PUMPPORTAL_MAX_TRADE_SUBS=400
PUMPPORTAL_TRADE_SUB_BATCH=80
PUMPPORTAL_TRADE_SUB_ROTATE_MS=20000
# Max mints from feed that must keep PumpPortal trade streams
# FEED_TRADE_PIN_MAX / LIVE_FEED_MAX — see trading/constants.ts

# ─── Holders (Helius required for real counts) ──────────────────
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# QUICKNODE_RPC_URL=
# TRITON_RPC_URL=
HELIUS_WEBHOOK_SECRET=

BUBBLEMAPS_API_KEY=
HOLDER_ENRICH_INTERVAL_MS=60000
HOLDER_ENRICH_BATCH=60
HELIUS_GPA_MAX_PAGES=15

# ─── Autotrader ───────────────────────────────────────────────────
# Server-side EV signals (WebSocket autotrader:signal). UI toggle also syncs via PUT /autotrader/rules.
AUTOTRADER_ENABLED=false

# ─── Execution ────────────────────────────────────────────────────
JUPITER_API_URL=https://quote-api.jup.ag/v6
EXEC_MAX_RETRIES=3
EXEC_MIN_PRIORITY_FEE=0.00005
EXEC_MAX_PRIORITY_FEE=0.001
JITO_BUNDLES_ENABLED=false
