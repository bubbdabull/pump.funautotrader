# Production (Vercel + Fly.io API): Vercel → Settings → Environment Variables
# Name: VITE_API_URL   Value: https://pump-funautotrader.fly.dev/api   (URL only, no "VITE_API_URL=")
# Name: VITE_WS_URL    Value: https://pump-funautotrader.fly.dev

# Local dev with local API (npm run start:dev + npm run dev):
VITE_API_URL=/api
VITE_WS_URL=

VITE_SUPABASE_URL=https://ypzgxjdnllwoohybayus.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# Keep false — server relays PumpPortal; true can break the UI
VITE_PUMPPORTAL_DIRECT=false
VITE_PUMPPORTAL_API_KEY=

VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
VITE_SOLANA_NETWORK=mainnet-beta
