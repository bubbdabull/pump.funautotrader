# Frontend — copy to .env in project root
# cp .env.example .env

# Recommended (live feed from Fly — no local server needed):
VITE_API_URL=https://pump-funautotrader.fly.dev/api
VITE_WS_URL=https://pump-funautotrader.fly.dev

# Optional: local Nest on :3001 (vite proxies /api → Fly by default anyway)
# VITE_API_URL=/api
# VITE_WS_URL=

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_PUMPPORTAL_WS=wss://pumpportal.fun/api/data
VITE_PUMPPORTAL_DIRECT=false

VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
VITE_SOLANA_NETWORK=mainnet-beta

# Backend: see server/.env.example
